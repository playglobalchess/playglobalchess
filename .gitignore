# ---- OS / editor ----
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
*.iml

# ---- Rust (engine, services) ----
target/
**/*.rs.bk
Cargo.lock.orig

# ---- Node / Web (clients/web, tooling) ----
node_modules/
dist/
build/
.next/
*.log
npm-debug.log*
yarn-error.log*
.pnpm-store/
coverage/

# ---- Swift / iOS (clients/ios) ----
clients/ios/**/.build/
clients/ios/**/DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/

# ---- Kotlin / Android (clients/android) ----
clients/android/**/.gradle/
clients/android/**/build/
local.properties
*.apk
*.aab

# ---- Python (tooling, scripts) ----
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# ---- Secrets / local env (NEVER commit) ----
.env
.env.*
*.pem
*.key
secrets/
*.local

# ---- Build / infra artifacts ----
*.tfstate
*.tfstate.*
.terraform/

# ---- KiroCrew local agent/CLI state (NOT project source) ----
# Per-developer CLI config + lock written by the KiroCrew agent runtime.
# The rest of .kiro/ (steering/, hooks/, agents/) IS tracked project infra —
# only this per-user settings dir is machine-local and must stay out.
.kiro/settings/

# ---- Generated mobile parity artifacts (§8.8, produced by build_mobile.sh) ----
# UniFFI-generated bindings, cross-compiled native libs, and the xcframework are
# BUILD OUTPUTS, not source — the test-target scaffolds + the hand-written
# parity tests are committed; these generated drop-ins are not.
clients/ios/EngineParityTests/Sources/
clients/ios/EngineParityTests/Frameworks/
clients/android/engine-parity/src/main/jniLibs/
clients/android/engine-parity/src/main/kotlin/uniffi/

# ---- Generated codec parity artifacts (§8/PLAN-CODEC 4.3, build_codec_mobile.sh) ----
# Same rule as the engine parity block above: the test-target scaffolds + the
# hand-written parity tests are committed; the generated bindings, cross-compiled
# native libs, and the xcframework are build outputs and are not.
clients/ios/CodecParityTests/Sources/
clients/ios/CodecParityTests/Frameworks/
clients/android/codec-parity/src/main/jniLibs/
clients/android/codec-parity/src/main/kotlin/uniffi/

# ---- Gradle (root Android build) ----
# (build/ and clients/android/**/build/ already covered above.) Root cache +
# ensure the committed wrapper jar is NOT ignored by the generic *.jar rules.
.gradle/
!gradle/wrapper/gradle-wrapper.jar

# ---- Generated web codec wasm artifacts (PLAN-CODEC 4.4, build_codec_web.sh) ----
# wasm-pack output + wasm target dirs are BUILD OUTPUTS, not source — the crate,
# tests, scripts and README are committed; these generated drop-ins are not.
protocol/codec-wasm/pkg/
protocol/codec-wasm/pkg-node/
protocol/codec-wasm/target-wasm/

# ---- Generated Go cgo codec artifacts (PLAN-S2-CODEC 4.5) ----
# The staticlib + header staged for cgo by `make lib` are build outputs; the
# crate, Go wrapper/test, Makefile and header SOURCE are committed, the staged
# copies are not.
services/game-server/internal/codec/lib/

# ---- Generated Go cgo engine artifacts (SPEC-S2-GAME-SERVER-GS2) ----
# Same discipline: the pgc-engine-cgo staticlib staged for cgo by `make lib` is
# a build output; the crate, Go wrapper/test, Makefile and header SOURCE are
# committed, the staged .a is not.
services/game-server/internal/engine/lib/
