# ---- OS / editor ----
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
*.iml

# ---- Rust (engine, services) ----
target/
**/*.rs.bk
Cargo.lock.orig

# ---- Node / Web (clients/web, tooling) ----
node_modules/
dist/
build/
.next/
*.log
npm-debug.log*
yarn-error.log*
.pnpm-store/
coverage/

# ---- Swift / iOS (clients/ios) ----
clients/ios/**/.build/
clients/ios/**/DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/

# ---- Kotlin / Android (clients/android) ----
clients/android/**/.gradle/
clients/android/**/build/
local.properties
*.apk
*.aab

# ---- Python (tooling, scripts) ----
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# ---- Secrets / local env (NEVER commit) ----
.env
.env.*
*.pem
*.key
secrets/
*.local

# ---- Build / infra artifacts ----
*.tfstate
*.tfstate.*
.terraform/

# ---- KiroCrew local agent/CLI state (NOT project source) ----
# Per-developer CLI config + lock written by the KiroCrew agent runtime.
# The rest of .kiro/ (steering/, hooks/, agents/) IS tracked project infra —
# only this per-user settings dir is machine-local and must stay out.
.kiro/settings/

# ---- Generated mobile parity artifacts (§8.8, produced by build_mobile.sh) ----
# UniFFI-generated bindings, cross-compiled native libs, and the xcframework are
# BUILD OUTPUTS, not source — the test-target scaffolds + the hand-written
# parity tests are committed; these generated drop-ins are not.
clients/ios/EngineParityTests/Sources/
clients/ios/EngineParityTests/Frameworks/
clients/android/engine-parity/src/main/jniLibs/
clients/android/engine-parity/src/main/kotlin/uniffi/

# ---- Gradle (root Android build) ----
# (build/ and clients/android/**/build/ already covered above.) Root cache +
# ensure the committed wrapper jar is NOT ignored by the generic *.jar rules.
.gradle/
!gradle/wrapper/gradle-wrapper.jar
